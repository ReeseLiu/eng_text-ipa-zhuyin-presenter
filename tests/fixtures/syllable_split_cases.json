  "cases": [
    {
      "id": "kw_onset_headquarters",
      "word": "headquarters",
      "ipa": [
        "h",
        "ɛ",
        "d",
        "k",
        "w",
        "ɔ",
        "ɹ",
        "t",
        "ɚ",
        "z"
      ],
      "expected": {
        "status": "ok",
        "code": null,
        "segments": [
          "head",
          "quar",
          "ters"
        ]
      },
      "note": "/kw/ onset puts the cut before q"
    },
